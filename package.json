{
  "name": "svg-editor-phase1",
  "version": "0.1.0",
  "private": true,
  "description": "Lab1 Phase 1 — object-oriented SVG CLI editor",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "cli": "npm run build --silent && node dist/src/cli/main.js",
    "test": "npm run build --silent && node --test dist/test/*.test.js",
    "test:coverage": "npm run build --silent && node --experimental-test-coverage --test dist/test/*.test.js",
    "check": "npm test && node scripts/check-architecture.mjs"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  }
}
